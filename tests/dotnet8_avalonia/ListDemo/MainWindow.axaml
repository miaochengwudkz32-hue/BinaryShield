<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ListDemo.MainWindow"
        Title="ListDemo"
        Width="520" Height="600"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
      <Button x:Name="ClickButton" Content="Click me" Click="OnButtonClick" Padding="16,6"/>
      <TextBlock Text="{Binding ClickCount, StringFormat='Clicks: {0}'}" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Opacity="0.7"/>
    </StackPanel>
    <ListBox x:Name="ItemList" ItemsSource="{Binding Items}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal" Spacing="16">
            <TextBlock Text="{Binding Name}" Width="140"/>
            <TextBlock Text="{Binding Detail}"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
